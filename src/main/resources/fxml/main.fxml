<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gitmini.controller.MainController"
            prefWidth="1200" prefHeight="800">

    <center>
        <SplitPane fx:id="mainSplitPane" dividerPositions="0.2">

            <!-- ========== 사이드바 ========== -->
            <VBox fx:id="sidebar" styleClass="sidebar" minWidth="200" maxWidth="400">

                <Label text="레포지토리" styleClass="sidebar-header"/>

                <ListView fx:id="repoListView" VBox.vgrow="ALWAYS"/>

                <HBox styleClass="sidebar-actions" alignment="CENTER" spacing="8">
                    <Button text="+ 추가" onAction="#onAddRepo"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Clone" onAction="#onCloneRepo"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

            </VBox>

            <!-- ========== 메인 콘텐츠 영역 ========== -->
            <VBox fx:id="mainContent" styleClass="main-content" alignment="CENTER">

                <Label fx:id="welcomeLabel"
                       text="레포지토리를 선택하세요"
                       styleClass="welcome-text"/>

            </VBox>

        </SplitPane>
    </center>

    <!-- ========== 하단 상태바 ========== -->
    <bottom>
        <HBox fx:id="statusBar" styleClass="status-bar" alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="statusLabel" text="✓ Ready"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="branchLabel" text=""/>
        </HBox>
    </bottom>

</BorderPane>
